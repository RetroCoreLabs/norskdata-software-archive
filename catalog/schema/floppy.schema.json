{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RetroCoreLabs/norskdata-software-archive/catalog/schema/floppy.schema.json",
  "title": "Norsk Data Floppy Catalog Entry",
  "description": "Schema v1.0 for entries in catalog/floppies.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "type",
    "md5",
    "imageFormat"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version. Breaking changes bump major."
    },
    "id": {
      "type": "string",
      "description": "Content-derived ID: {productId}-{version}-d{diskNumber}-{md5[:8]} or md5[:12] for uncategorized"
    },
    "type": {
      "type": "string",
      "enum": [
        "floppy",
        "hdd",
        "rom",
        "tape",
        "firmware"
      ],
      "description": "Media type"
    },
    "md5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "MD5 checksum of the image file"
    },
    "volumeName": {
      "type": [
        "string",
        "null"
      ],
      "description": "NDFS volume name as read from the image"
    },
    "volumeNameRaw": {
      "type": [
        "string",
        "null"
      ],
      "description": "Hex-encoded volume name when original contains non-printable characters"
    },
    "productId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Matched product article number (e.g., ND-10325)"
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Product version letter or number"
    },
    "systemNumber": {
      "type": [
        "string",
        "null"
      ],
      "description": "ND system number from the SINTRAN III OS distribution floppy naming N-<system no>-I..IV (see ND-10174-10-EN). Only the early SINTRAN III OS sets carry one; null otherwise."
    },
    "diskNumber": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Disk number in a multi-disk set"
    },
    "diskTotal": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Total number of disks in the set"
    },
    "mediaRole": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "os-boot-floppy",
        "os-image-cont",
        "tools-symbols",
        "patch-floppy",
        "application",
        "diagnostics",
        "tools",
        "unknown",
        null
      ],
      "description": "Semantic role from product-matcher"
    },
    "storageClass": {
      "type": "string",
      "enum": [
        "floppy-in-git",
        "ia-only",
        "both"
      ],
      "description": "Where the binary image is stored"
    },
    "imageSizeBytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Size of the image file in bytes"
    },
    "imageFormat": {
      "type": "string",
      "enum": [
        "raw",
        "imd",
        "td0",
        "hfe",
        "scp"
      ],
      "description": "Image file format"
    },
    "controller": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "floppy",
        "SMD",
        "WD-ST506",
        "SCSI",
        null
      ],
      "description": "Storage controller type (required for emulator mounting)"
    },
    "totalPages": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Total NDFS pages on the media"
    },
    "pageSize": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        1024,
        2048,
        null
      ],
      "description": "NDFS page size in bytes"
    },
    "bootFormat": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "none",
        "flomon",
        "binary",
        "bpun",
        null
      ],
      "description": "Boot format discriminator for product matching"
    },
    "cpuTarget": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Target CPU models (e.g., ND-100, NORD-10)"
    },
    "osRequirement": {
      "type": [
        "string",
        "null"
      ],
      "description": "Required operating system (e.g., SINTRAN III VS)"
    },
    "ndfs": {
      "type": [
        "object",
        "null"
      ],
      "description": "NDFS filesystem metadata extracted from the image",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "pagesUsed": {
                "type": "integer"
              }
            },
            "required": [
              "name",
              "pagesUsed"
            ]
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "pages": {
                "type": "integer"
              },
              "bytes": {
                "type": "integer"
              }
            },
            "required": [
              "name",
              "type",
              "pages"
            ]
          }
        }
      }
    },
    "directoryContentRaw": {
      "type": [
        "string",
        "null"
      ],
      "description": "Raw directory listing from legacy system"
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ],
      "description": "Origin and imaging information",
      "properties": {
        "contributor": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "dateImaged": {
          "type": [
            "string",
            "null"
          ]
        },
        "originalPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "storage": {
      "type": [
        "object",
        "null"
      ],
      "description": "Storage locations for the binary artifact",
      "properties": {
        "git": {
          "type": [
            "object",
            "null"
          ],
          "description": "In-repo gzipped image storage",
          "properties": {
            "imagePath": {
              "type": "string",
              "description": "Path to .img.gz relative to repo root"
            },
            "labelPhotos": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Paths to label photo files relative to repo root"
            },
            "labelTranscription": {
              "type": [
                "string",
                "null"
              ],
              "description": "Path to labels.txt relative to repo root"
            }
          }
        },
        "internetArchive": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "itemId": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "uploaded": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified": {
              "type": [
                "string",
                "null"
              ]
            },
            "syncStatus": {
              "type": "string",
              "enum": [
                "pending",
                "uploaded",
                "modified",
                "not-applicable"
              ],
              "description": "Sync status with Internet Archive"
            }
          }
        }
      }
    },
    "variants": {
      "type": [
        "array",
        "null"
      ],
      "description": "Alternative imaging or source variants of the same logical media",
      "items": {
        "type": "object",
        "properties": {
          "md5": {
            "type": "string"
          },
          "contributor": {
            "type": [
              "string",
              "null"
            ]
          },
          "method": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "iaFile": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "md5",
          "role"
        ]
      }
    },
    "fluxPreservation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Raw flux capture information",
      "properties": {
        "hasRawFlux": {
          "type": "boolean"
        },
        "fluxFormat": {
          "type": [
            "string",
            "null"
          ]
        },
        "fluxIaFile": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "legacyRefs": {
      "type": [
        "object",
        "null"
      ],
      "description": "Legacy references from the old ndfloppy system",
      "properties": {
        "pisheetUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "articleUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "manualId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "programDescriptionId": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "legacyId": {
      "type": [
        "integer",
        "null"
      ],
      "description": "ID from the legacy ndfloppy application"
    },
    "importedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "ISO 8601 timestamp of import"
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "Freeform tags for search and filtering"
    },
    "filesystem": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ndfs",
        "dos",
        "tar",
        "backup",
        "winch",
        "none",
        null
      ],
      "description": "What the image holds: ndfs, dos, tar, backup (SINTRAN III BACKUP-SYSTEM ANSI-labelled volume), winch (WINCH-TO-FLOPP directory backup), or none."
    },
    "volumeLabel": {
      "type": [
        "string",
        "null"
      ],
      "description": "Volume label of a non-NDFS filesystem (the FAT label of an MS-DOS disk). These often carry an ND part number."
    },
    "backupSet": {
      "type": [
        "object",
        "null"
      ],
      "description": "Which backup set this image is one volume of, read from the volume header or the ANSI labels. WINCH-TO-FLOPP spreads one ND directory over a set of floppies; SINTRAN III BACKUP-SYSTEM writes a run of labelled volumes with no volume number.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "winch",
            "backup"
          ]
        },
        "name": {
          "type": "string",
          "description": "WINCH: directory backed up. BACKUP-SYSTEM: VOL1 volume id."
        },
        "label": {
          "type": "string",
          "description": "WINCH: free text label. BACKUP-SYSTEM: VOL1 owner."
        },
        "volumeNumber": {
          "type": "integer",
          "minimum": 1
        },
        "totalVolumes": {
          "type": "integer",
          "minimum": 1
        },
        "pageCount": {
          "type": "integer",
          "minimum": 0
        },
        "pageFirst": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pageLast": {
          "type": [
            "integer",
            "null"
          ]
        },
        "listedPages": {
          "type": "integer",
          "minimum": 0,
          "description": "Pages the header says the volume holds; more than pageCount means the image is an incomplete read of the floppy"
        },
        "imageBytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the raw image the header was read from"
        },
        "runDate": {
          "type": [
            "string",
            "null"
          ],
          "description": "BACKUP-SYSTEM: date of the run that wrote this volume"
        },
        "system": {
          "type": [
            "string",
            "null"
          ],
          "description": "BACKUP-SYSTEM: system code from the labels, e.g. SINTRAN III L"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0,
          "description": "BACKUP-SYSTEM: files named by the labels, leftovers excluded"
        },
        "staleCount": {
          "type": "integer",
          "minimum": 0,
          "description": "BACKUP-SYSTEM: labels left over from an older backup on the same media"
        },
        "firstFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "endsMidFile": {
          "type": "boolean",
          "description": "BACKUP-SYSTEM: the last file has no EOF1 and continues on the next volume"
        },
        "fileListHash": {
          "type": "string",
          "description": "BACKUP-SYSTEM: fingerprint of the file names, so repeat reads can be told from distinct volumes"
        }
      },
      "required": [
        "kind",
        "name"
      ]
    },
    "backupFiles": {
      "type": [
        "array",
        "null"
      ],
      "description": "Files named by the ANSI labels of a SINTRAN III BACKUP-SYSTEM volume. The labels are the only listing this format has.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "NAME:TYPE as SINTRAN writes it"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "created": {
            "type": [
              "string",
              "null"
            ]
          },
          "system": {
            "type": [
              "string",
              "null"
            ]
          },
          "continued": {
            "type": "boolean",
            "description": "the file runs on to the next volume of the run"
          },
          "stale": {
            "type": "boolean",
            "description": "label left over from an older backup on the same media"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "condition": {
      "type": [
        "object",
        "null"
      ],
      "description": "State of the media when it is not simply readable. 'damaged' means the image holds ND material - SINTRAN file names are present in the bytes - but the filesystem structures cannot be read, so no file list can be produced.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "damaged"
          ]
        },
        "parser": {
          "type": "string",
          "enum": [
            "ndfs"
          ]
        },
        "parserError": {
          "type": "string",
          "description": "what the parser said when it refused the image"
        },
        "ndNamesFound": {
          "type": "integer",
          "minimum": 0,
          "description": "distinct ND-style NAME:TYPE strings found in the raw bytes"
        },
        "ndNameSamples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recovery": {
          "type": [
            "object",
            "null"
          ],
          "description": "Set when the file list was recovered by reconstructing the master block pointers from what healthy floppies of the same geometry use. The list in ndfs then exists but was not read from an intact filesystem.",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "recovered"
              ]
            },
            "layout": {
              "type": "object",
              "properties": {
                "object": {
                  "type": "integer"
                },
                "user": {
                  "type": "integer"
                },
                "bit": {
                  "type": "integer"
                }
              }
            },
            "filesRecovered": {
              "type": "integer",
              "minimum": 0
            },
            "namesConfirmedInBytes": {
              "type": "integer",
              "minimum": 0,
              "description": "how many recovered names occur in the image's own bytes"
            },
            "confirmRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "acceptedBy": {
              "type": "string",
              "enum": [
                "own-bytes",
                "sibling-listing"
              ],
              "description": "Which evidence carried the recovery: the image's own bytes, or another read of the same physical floppy listing the same files"
            },
            "corroboratedBySibling": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "status"
          ]
        }
      },
      "required": [
        "status"
      ]
    },
    "dosFiles": {
      "type": [
        "array",
        "null"
      ],
      "description": "Directory tree of an MS-DOS floppy, root and subdirectories, so the catalog can list and search it without opening the image.",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "full path from the root, e.g. ND-OWS/SETUP.EXE"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "modified": {
            "type": [
              "string",
              "null"
            ]
          },
          "directory": {
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  "additionalProperties": false
}
