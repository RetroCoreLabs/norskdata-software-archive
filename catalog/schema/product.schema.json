{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RetroCoreLabs/norskdata-software-archive/catalog/schema/product.schema.json",
  "title": "Norsk Data Product Entry",
  "description": "Schema for entries in catalog/products.json",
  "type": "object",
  "required": ["Id", "Name"],
  "properties": {
    "Id": {
      "type": "string",
      "description": "Product article number (e.g., ND-10022, ND-210079N)"
    },
    "Name": {
      "type": "string",
      "description": "Product name or description"
    }
  },
  "additionalProperties": false
}
